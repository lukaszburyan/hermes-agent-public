# Secret-free template for local/VPS setup.
# Replace every <SET_ME> value. Never commit a completed .env.

TELEGRAM_BOT_TOKEN=<SET_ME>
TELEGRAM_ALLOWED_USERS=<SET_ME_TELEGRAM_USER_ID>
TELEGRAM_HOME_CHANNEL=<SET_ME_TELEGRAM_CHAT_ID>
GITHUB_TOKEN=<SET_ME>
GITHUB_USERNAME=<SET_ME>
GITHUB_REPO_NAME=hermes-agent-public
GITHUB_REPO_URL=https://github.com/lukaszburyan/hermes-agent-public
HERMES_TIMEZONE=Europe/Warsaw
TZ=Europe/Warsaw
ORCHESTA_RFQ_SCHEMA_MODEL=gpt-5.4-nano
ORCHESTA_RFQ_VISION_DETAIL=low
ORCHESTA_RFQ_ATTACHMENT_EXTRACT_CLASSES=new_quote_request,quote_draft_ready,existing_client_request,existing_thread_reply,same_domain_new_person
ORCHESTA_RFQ_VISION_MODEL=gpt-5.4-mini
ORCHESTA_RFQ_ALLOW_SCHEMA_MODEL=0
ORCHESTA_RFQ_ALLOW_EXTERNAL_VISION=0
HERMES_RFQ_MARKER_TIMEOUT_SECONDS=30
ZOHO_MAIL_CLIENT_ID=<SET_ME>
ZOHO_MAIL_CLIENT_SECRET=<SET_ME>
ZOHO_MAIL_REFRESH_TOKEN=<SET_ME>
ZOHO_MAIL_ACCOUNT_EMAIL=<SET_ME_MAILBOX@example.com>
ZOHO_MAIL_REDIRECT_URI=http://localhost:8788/zoho/callback
ZOHO_MAIL_ACCOUNTS_BASE_URL=https://accounts.zoho.eu
ZOHO_MAIL_API_BASE_URL=https://mail.zoho.eu/api
ZOHO_MAIL_SCOPE=ZohoMail.accounts.READ,ZohoMail.folders.READ,ZohoMail.messages.READ,ZohoMail.messages.CREATE,ZohoMail.tags.READ
OBSIDIAN_VAULT_PATH=/path/to/vault
APIFY_API_TOKEN=<SET_ME>
HERMES_DRAFT_MODEL=openai-codex/gpt-5.6-luna
HERMES_INTERNAL_NOTIFY_EMAIL=<SET_ME_CONTROLLED_INTERNAL_EMAIL>
HERMES_GOOGLE_SHEETS_SPREADSHEET_ID=<SET_ME_CONTROLLED_SPREADSHEET_ID>
HERMES_TRANSPORT_KILL_SWITCH=1
HERMES_OPERATIONAL_AUTOSEND_ENABLED=0
HERMES_TEST_MODE=0
HERMES_TEST_RECIPIENT_ALLOWLIST=<SET_ME_CONTROLLED_TEST_EMAILS>
HERMES_BACKUP_AGE_RECIPIENT=<SET_ME_AGE_PUBLIC_RECIPIENT>
HERMES_BACKUP_OFFSITE_REMOTE=<SET_ME_RCLONE_REMOTE>:hermes-agent/state
HERMES_BACKUP_RETENTION_DAYS=30
HERMES_BACKUP_RETENTION_DELETE_APPROVED=0
