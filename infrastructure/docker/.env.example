# Secret-free Docker/Traefik template.
# Replace every <SET_ME> value. Never commit a completed .env.

ADMIN_USERNAME=<SET_ME_ADMIN>
ADMIN_PASSWORD=<SET_ME>
TRAEFIK_HOST=<SET_ME_HOSTNAME.example.com>
OBSIDIAN_VAULT_PATH=/path/to/vault
HERMES_RELEASE_IMAGE=ghcr.io/lukaszburyan/hermes-agent-public
HERMES_RELEASE_DIGEST=sha256:<SET_AFTER_CI>
HERMES_RUNTIME_DIR=./runtime
HERMES_RUNTIME_ENV_FILE=./runtime/.env
HERMES_RCLONE_CONFIG_DIR=./runtime/rclone
HERMES_RCLONE_CONFIG_FILE=./runtime/rclone/rclone.conf
HERMES_TRANSPORT_KILL_SWITCH=1
HERMES_OPERATIONAL_AUTOSEND_ENABLED=0
HERMES_TEST_MODE=0
HERMES_TEST_RECIPIENT_ALLOWLIST=
HERMES_RFQ_MARKER_ENABLED=0
